{
  "name": "farja",
  "version": "1.0.0",
  "private": true,
  "description": "Farja — Egyptian cinematic streaming platform built with Next.js 15, Prisma and TMDB",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && node scripts/prepare-db.mjs && next build",
    "start": "next start",
    "postinstall": "node scripts/postinstall.mjs",
    "catalog:build": "python3 scripts/build_catalog.py --movies ./datasets/movies_metadata.csv --tv ./datasets/TMDB_tv_dataset_v3.csv --credits ./datasets/tmdb_5000_credits.csv"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tabs": "^1.1.13",
    "bcryptjs": "^3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.468.0",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "next-intl": "^4.14.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "prisma": "6.16.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3"
  }
}
