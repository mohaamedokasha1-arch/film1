# ---------------------------------------------------------------------------
# Farja — environment variables
# Copy this file to `.env.local` for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# ---------------------------------------------------------------------------

# [required for real accounts] PostgreSQL connection string (Neon / Vercel Postgres / Supabase)
# Example: postgresql://user:password@host/db?sslmode=require
DATABASE_URL=

# [optional] TMDB v3 API key — free: https://www.themoviedb.org/settings/api
# Without it the site runs on a bundled, real TMDB dataset (offline fallback).
TMDB_API_KEY=

# [optional] Alternative to TMDB_API_KEY: a v4 read access token (Bearer)
TMDB_READ_TOKEN=

# [required in production] Secret used to sign NextAuth JWTs
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=

# Public URL of the deployed site (used by metadata / sitemap)
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [optional] Replaces the seeded admin account. If omitted:
#   ADMIN_EMAIL    = admin@farja.app
#   ADMIN_PASSWORD = Admin@12345
ADMIN_EMAIL=
ADMIN_PASSWORD=

# [optional] Google Search Console verification token (renders
# <meta name="google-site-verification"> inside <head>). Defaults to the
# token committed in src/config/site.ts.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# [optional] Set to "1" to enable Vercel/Next image optimisation
NEXT_IMAGE_OPTIMIZATION=0
